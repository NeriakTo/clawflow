    "claude-code",
    "codex",
    "gemini",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NeriakTo/clawflow.git"
  },
  "homepage": "https://github.com/NeriakTo/clawflow",
  "bugs": {
    "url": "https://github.com/NeriakTo/clawflow/issues"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xyflow/react": "^12.0.0",
    "better-sqlite3": "^11.0.0",
